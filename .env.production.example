# Frontend values for Cloudflare Pages
VITE_CONVEX_URL=https://your-convex-deployment.convex.cloud
VITE_CONVEX_SITE_URL=https://your-convex-site.convex.site
VITE_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_publishable_key
VITE_SENTRY_DSN=https://your-frontend-sentry-dsn
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_PUTER_ENABLED=true

# Optional frontend feature flags
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Convex backend values
# Set these in Convex dashboard, not in Cloudflare Pages.
# CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain
# CLERK_APPLICATION_ID=convex
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_your_clerk_webhook_secret
# CONVEX_SITE_URL=https://your-convex-site.convex.site
# MISTRAL_API_KEY=your_mistral_api_key
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=BALANCE <no-reply@yourdomain.com>
# ADMIN_SETUP_TOKEN=your_admin_setup_token
